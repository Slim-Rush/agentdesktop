%% Current implemented architecture (baseline).
%% Phase 1 target additions live in system_design_target.mmd.
graph TB
    subgraph Workstation["Developer workstation"]
        Desktop["Agent Desktop<br/>(Tauri, crates/agentdesktop)"]
        Daemon["Agent daemon<br/>(crates/agent)"]
        Client["Local client<br/>(crates/client)"]
        Tools["Managed developer tools<br/>Claude Code, Claude Desktop, Codex,<br/>OpenCode, Grok, Copilot, VS Code"]
        DiscoveryOnly["Discovery-only tools<br/>Cursor, Ollama"]
        State["Local state<br/>config, device identity,<br/>usage store"]
    end

    subgraph Controller["Fleet controller (crates/controller)"]
        Fleet["Fleet gRPC API<br/>FleetAgent"]
        Admin["Admin HTTP API<br/>/api/v1/*"]
        DB[("SQLite / PostgreSQL<br/>devices, discoveries,<br/>program status, usage")]
        CA["Device CA"]
        JWTSigner["Gateway JWT issuer<br/>JWKS"]
        UsageIngest["Usage ingest<br/>OTLP logs"]
    end

    subgraph External["External services"]
        OIDC["OIDC identity provider"]
        Gateway["LLM gateway<br/>(agentgateway)"]
        GitHub["GitHub OAuth"]
    end

    AdminUI["Controller web UI<br/>(frontend/controller)"]
    AdminUser["Platform admin"]
    Developer["Developer"]

    Developer --> Desktop
    Desktop --> Client
    Client -->|"Unix socket / named pipe<br/>HTTP JSON"| Daemon
    Daemon -->|"discover + reconcile"| Tools
    Daemon -->|"discover"| DiscoveryOnly
    Daemon --> State
    Desktop -->|"Tauri commands"| Client

    Daemon -->|"gRPC over TLS<br/>device cert + OIDC token"| Fleet
    Fleet --> DB
    Fleet --> CA
    Fleet --> JWTSigner
    Fleet -->|"daemon config push<br/>stream"| Daemon
    Daemon -->|"inventory, config status,<br/>telemetry, usage"| Fleet

    Daemon -->|"device authorization /<br/>code exchange"| OIDC
    Fleet --> OIDC
    Daemon -->|"GitHub OAuth"| GitHub

    Daemon -->|"credential request +<br/>local proxy"| Gateway
    Gateway -->|"OTLP access logs"| UsageIngest
    UsageIngest --> DB

    AdminUser --> AdminUI
    AdminUI -->|"HTTP JSON /api/v1/*"| Admin
    Admin --> DB
    Admin --> JWTSigner

    classDef external fill:#eee,stroke:#999;
    class OIDC,Gateway,GitHub external;
